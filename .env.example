ANTHROPIC_API_KEY=sk-ant-your-key-here
RESEND_API_KEY=re_your-key-here
PORT=3000

# Visa monitor (monitor.js) — any SMTP provider works. With Resend:
# SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<your RESEND_API_KEY>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_FROM=BordersX Alerts <alerts@bordersx.com>
# Folder holding snapshots/ (a Railway volume in production)
MONITOR_DATA_DIR=
# Alert recipients: a Google Sheet with an "email" column, shared (Viewer) with
# the service account's client_email. Paste the whole key JSON on one line.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=
GOOGLE_SERVICE_ACCOUNT_JSON=
